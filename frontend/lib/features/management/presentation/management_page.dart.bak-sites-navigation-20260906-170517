                      ),
                    ),
                  ),
                ),
              ],

              const SizedBox(height: 10),

              Align(
                alignment: Alignment.centerLeft,
                child: Text(
                  'Le pilote pourra utiliser ce mot de passe pour sa première connexion.',
                  style: TextStyle(fontSize: 12, color: Colors.grey.shade600),
