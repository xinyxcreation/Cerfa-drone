              : const Icon(Icons.refresh),
        ),
      ],
      children: [
        _DroneHeader(count: _drones.length, onAdd: _addDrone),

        const SizedBox(height: 16),

        if (_loading)
          const Padding(
            padding: EdgeInsets.all(40),
