typedef ManagementPageOpener =
    void Function(Widget page, {VoidCallback? onReturn});

class ManagementBackScope extends InheritedWidget {
  const ManagementBackScope({
    super.key,
    required this.onBack,
    required super.child,
  });

  final VoidCallback onBack;

  static ManagementBackScope? maybeOf(BuildContext context) {
    return context.dependOnInheritedWidgetOfExactType<ManagementBackScope>();
  }

  @override
  bool updateShouldNotify(ManagementBackScope oldWidget) {
    return onBack != oldWidget.onBack;
  }
}

