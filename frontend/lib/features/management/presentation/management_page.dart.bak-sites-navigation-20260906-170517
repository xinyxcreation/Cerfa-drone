class _FormField extends StatelessWidget {
  const _FormField({
    required this.controller,
    required this.label,
    required this.icon,
    this.validator,
    this.keyboardType,
    this.enabled = true,
  });

  final TextEditingController controller;
  final String label;
  final IconData icon;
  final String? Function(String?)? validator;
  final TextInputType? keyboardType;
  final bool enabled;

  @override
  Widget build(BuildContext context) {
    return TextFormField(
      controller: controller,
      enabled: enabled,
      keyboardType: keyboardType,
      validator: validator,
      decoration: _inputDecoration(label: label, icon: icon),
    );
  }
}

InputDecoration _inputDecoration({
  required String label,
  required IconData icon,
  Widget? suffixIcon,
}) {
  return InputDecoration(
    labelText: label,
    prefixIcon: Icon(icon),
    suffixIcon: suffixIcon,
    filled: true,
    fillColor: Colors.white,
    border: OutlineInputBorder(
      borderRadius: BorderRadius.circular(13),
      borderSide: BorderSide.none,
    ),
    enabledBorder: OutlineInputBorder(
      borderRadius: BorderRadius.circular(13),
      borderSide: BorderSide.none,
    ),
    focusedBorder: OutlineInputBorder(
      borderRadius: BorderRadius.circular(13),
      borderSide: const BorderSide(color: Color(0xFFE30613), width: 1.4),
    ),
  );
}

class _PilotCertificationTile extends StatelessWidget {
  const _PilotCertificationTile({required this.certification});

  final PilotCertification certification;

  @override
  Widget build(BuildContext context) {
    final expired = certification.isExpired;
    final expiringSoon = certification.isExpiringSoon;

    final Color statusColor;

    if (expired || !certification.isValid) {
      statusColor = const Color(0xFFE30613);
    } else if (expiringSoon) {
      statusColor = Colors.orange;
    } else {
      statusColor = Colors.green;
    }

    final String status;

    if (expired) {
      status = 'Expirée';
    } else if (!certification.isValid) {
      status = 'Invalide';
    } else if (expiringSoon) {
      status = 'Expire bientôt';
    } else {
      status = 'Valide';
    }

    String formatDate(DateTime? date) {
      if (date == null) return '—';

      return '${date.day.toString().padLeft(2, '0')}/'
          '${date.month.toString().padLeft(2, '0')}/'
          '${date.year}';
    }

    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: Colors.grey.shade50,
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: Colors.grey.shade200),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Expanded(
                child: Text(
                  certification.label,
                  style: const TextStyle(
                    fontWeight: FontWeight.w800,
                    fontSize: 15,
                  ),
                ),
              ),
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 9, vertical: 5),
                decoration: BoxDecoration(
                  color: statusColor.withValues(alpha: 0.10),
                  borderRadius: BorderRadius.circular(20),
                ),
                child: Text(
                  status,
                  style: TextStyle(
                    color: statusColor,
                    fontSize: 12,
                    fontWeight: FontWeight.w800,
                  ),
                ),
              ),
            ],
          ),

          const SizedBox(height: 8),

          Text(
            'Obtenue le ${formatDate(certification.obtainedAt)}',
            style: TextStyle(fontSize: 13, color: Colors.grey.shade700),
          ),

          if (certification.expiresAt != null) ...[
            const SizedBox(height: 3),
            Text(
              'Expiration : ${formatDate(certification.expiresAt)}',
              style: TextStyle(fontSize: 13, color: Colors.grey.shade700),
            ),
          ],

          if (certification.description != null &&
              certification.description!.trim().isNotEmpty) ...[
            const SizedBox(height: 6),
            Text(
              certification.description!,
              style: TextStyle(fontSize: 12, color: Colors.grey.shade600),
            ),
          ],

          if (certification.notes != null &&
              certification.notes!.trim().isNotEmpty) ...[
            const SizedBox(height: 6),
            Text(
              certification.notes!,
              style: TextStyle(fontSize: 12, color: Colors.grey.shade700),
            ),
          ],
        ],
      ),
    );
  }
}

