class _DronesPageState extends State<DronesPage> {
  bool _loading = true;
  bool _refreshing = false;

  String? _error;

  List<CompanyDrone> _drones = [];

  @override
  void initState() {
    super.initState();
    _loadDrones();
  }

  Future<void> _loadDrones() async {
    if (!_refreshing) {
      setState(() {
        _loading = true;
        _error = null;
      });
    }

    try {
      final drones = await DronesService.getDrones();

      if (!mounted) return;

      setState(() {
        _drones = drones;
        _loading = false;
        _refreshing = false;
        _error = null;
      });
    } catch (error) {
      if (!mounted) return;

      setState(() {
        _loading = false;
        _refreshing = false;
        _error = error.toString().replaceFirst('Exception: ', '');
      });
    }
  }

  Future<void> _refresh() async {
    if (_refreshing) return;

    setState(() {
      _refreshing = true;
    });

    await _loadDrones();
  }

  void _addDrone() {
    widget.onOpenPage(
      const CreateDronePage(),
      onReturn: () {
        _loadDrones();
      },
    );
  }

